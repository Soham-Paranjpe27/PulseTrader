# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://pulsetrader:change-me@localhost:5432/pulsetrader
# e2e tests only; must differ from DATABASE_URL (each run creates and drops its own schema)
TEST_DATABASE_URL=postgresql://pulsetrader:change-me@localhost:5432/pulsetrader_test
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
REDIS_URL=redis://localhost:6379/0
ML_SERVICE_URL=http://localhost:8000
# API (NestJS)
PORT=3001
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
# trusted proxy hops in front of the API (1 when it is reached through the web app's /api proxy)
TRUST_PROXY=
# Web (Next.js): where the same-origin /api proxy forwards to (read at runtime)
API_URL=http://localhost:3001
# optional: seed creates this ADMIN user
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Live market data (Phase 17). MARKET_DATA_PROVIDER: kite (Zerodha Kite Connect, real time) or replay
# (recorded session, always shown as REPLAY). MockProvider is test-only and is refused outside tests.
MARKET_DATA_PROVIDER=
# Kite Connect app key/secret (developers.kite.trade). The access token is valid for one trading day:
# get it with `pulsetrader kite-login` after logging in at Zerodha. Never commit these.
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=
# shared secret between the live pipeline and the API ingestion endpoints (>= 32 random characters)
LIVE_INGEST_TOKEN=
# replay only: session date (validation period; the test period is refused) and speed (x real time)
LIVE_REPLAY_DATE=
LIVE_REPLAY_SPEED=1
NEWS_PROVIDER=
FUNDAMENTALS_PROVIDER=
# Historical data location (defaults to ./data)
PULSETRADER_DATA_DIR=./data
