# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://pulsetrader:change-me@localhost:5432/pulsetrader
JWT_SECRET=change-me-to-a-long-random-string
REDIS_URL=redis://localhost:6379/0
ML_SERVICE_URL=http://localhost:8000
# Market data provider for LIVE mode. MockProvider is test-only and is refused outside tests.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
NEWS_PROVIDER=
FUNDAMENTALS_PROVIDER=
# Historical data location (defaults to ./data)
PULSETRADER_DATA_DIR=./data
